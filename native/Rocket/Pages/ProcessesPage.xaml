<local:PageBase x:Class="Rocket.Pages.ProcessesPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:core="clr-namespace:Rocket.Core"
                xmlns:local="clr-namespace:Rocket.Pages">
    <local:PageBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />
        <Style x:Key="Stat" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
        <!-- group filter: a row of pills -->
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="14" Padding="12,5" Background="{DynamicResource Surface2}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:PageBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Path=[proc.title], Source={x:Static core:Loc.I}}" />
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left"
                       Text="{Binding Path=[proc.sub], Source={x:Static core:Loc.I}}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Sub}" Text="CPU" />
                    <TextBlock x:Name="CpuNow" Style="{StaticResource Stat}" Text="…" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource Sub}" Text="{Binding Path=[proc.memory], Source={x:Static core:Loc.I}}" />
                    <TextBlock x:Name="MemNow" Style="{StaticResource Stat}" Text="…" />
                    <ProgressBar x:Name="MemBar" Style="{StaticResource Meter}" Height="4" Maximum="1" Margin="0,4,30,0" />
                    <TextBlock x:Name="MemOf" Style="{StaticResource Sub}" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource Sub}" Text="{Binding Path=[proc.count], Source={x:Static core:Loc.I}}" />
                    <TextBlock x:Name="CountNow" Style="{StaticResource Stat}" Text="…" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Style="{StaticResource Sub}" Text="{Binding Path=[proc.uptime], Source={x:Static core:Loc.I}}" />
                    <TextBlock x:Name="UptimeNow" Style="{StaticResource Stat}" Text="…" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- what is worth acting on right now -->
        <ItemsControl x:Name="Findings" Grid.Row="2" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="b" CornerRadius="12" Padding="14,9" Margin="0,0,0,6" Background="{DynamicResource AccentSoft}">
                        <DockPanel>
                            <Button x:Name="act" DockPanel.Dock="Right" Style="{StaticResource Ghost}" Padding="12,5" Content="{Binding ActionText}"
                                    Click="FindingAction_Click" Visibility="{Binding HasAction, Converter={StaticResource BoolVis}}" />
                            <TextBlock x:Name="g" Style="{StaticResource Icon}" Text="&#xE946;" FontSize="13" Foreground="{DynamicResource Accent}" />
                            <TextBlock Text="{Binding Text}" Margin="10,0" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Warn}" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{DynamicResource DangerSoft}" />
                            <Setter TargetName="g" Property="Text" Value="&#xE7BA;" />
                            <Setter TargetName="g" Property="Foreground" Value="{DynamicResource Warn}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <DockPanel Grid.Row="3" Margin="0,8,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <ComboBox x:Name="SortBox" Style="{StaticResource Combo}" Width="130" SelectionChanged="Sort_Changed" />
                <TextBox x:Name="Search" Style="{StaticResource Field}" Width="190" Margin="8,0,0,0" TextChanged="Search_Changed"
                         Padding="10,6" FlowDirection="LeftToRight" />
            </StackPanel>
            <WrapPanel x:Name="GroupPills" />
        </DockPanel>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="6" Margin="0,6,0,20">
            <ListBox x:Name="List" Style="{StaticResource RowList}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:ProcRow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="14" Foreground="{DynamicResource Accent}" />
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource PathText}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border Width="60" Height="5" CornerRadius="2.5" Background="{DynamicResource Hover}" VerticalAlignment="Center">
                                    <Border HorizontalAlignment="Left" Width="{Binding CpuBar}" CornerRadius="2.5" Background="{DynamicResource AccentGrad}" />
                                </Border>
                                <TextBlock Text="{Binding CpuText}" Width="46" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding MemText}" Style="{StaticResource Size}" />
                            <ComboBox x:Name="prio" Grid.Column="4" Style="{StaticResource Combo}" Margin="10,0,0,0" Padding="8,4"
                                      ItemsSource="{Binding PriorityNames, RelativeSource={RelativeSource AncestorType=local:ProcessesPage}}"
                                      SelectedIndex="{Binding Priority, Mode=OneWay}" SelectionChanged="Priority_Changed"
                                      IsEnabled="{Binding CanAct}" />
                            <Button x:Name="end" Grid.Column="5" Style="{StaticResource CloseBtn}" Width="30" Height="28" Margin="6,0,0,0"
                                    Click="End_Click" IsEnabled="{Binding CanAct}"
                                    ToolTip="{Binding Path=[proc.end], Source={x:Static core:Loc.I}}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</local:PageBase>
