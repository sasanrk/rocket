<local:PageBase x:Class="Rocket.Pages.StartupPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:core="clr-namespace:Rocket.Core"
                xmlns:local="clr-namespace:Rocket.Pages">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" VerticalAlignment="Top" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock Margin="8,0,0,0" Text="{Binding Path=[common.rescan], Source={x:Static core:Loc.I}}" />
                </StackPanel>
            </Button>
            <StackPanel Margin="0,0,24,0">
                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Path=[startup.title], Source={x:Static core:Loc.I}}" />
                <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left"
                           Text="{Binding Path=[startup.sub], Source={x:Static core:Loc.I}}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,16">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="Count" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Bold" Text="…" />
                    <TextBlock x:Name="Summary" Style="{StaticResource Sub}" />
                </StackPanel>
                <Button x:Name="BtnElevate" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Ghost}"
                        Click="Elevate_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7EF;" FontSize="12"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Margin="8,0,0,0" Text="{Binding Path=[admin.btn], Source={x:Static core:Loc.I}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6" Margin="0,12,0,20">
            <ListBox x:Name="List" Style="{StaticResource RowList}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:StartupEntry}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="sw" Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}"
                                      Click="Toggle_Click" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                <TextBlock x:Name="name" Text="{Binding Display}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Publisher}" Style="{StaticResource Sub}" FontSize="11" TextWrapping="NoWrap" />
                                <TextBlock Text="{Binding Command}" Style="{StaticResource PathText}" />
                            </StackPanel>
                            <Border Grid.Column="2" Style="{StaticResource Badge}">
                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Scope}" />
                            </Border>
                            <TextBlock Grid.Column="3" Text="{Binding Usage}" Style="{StaticResource Sub}" FontSize="11.5"
                                       VerticalAlignment="Center" TextAlignment="Right" TextWrapping="NoWrap" Foreground="{DynamicResource Accent}" />
                            <Button Grid.Column="4" Style="{StaticResource IconBtn}" Width="30" Height="28" Margin="8,0,0,0"
                                    Click="Reveal_Click" ToolTip="{Binding Path=[common.reveal], Source={x:Static core:Loc.I}}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                <Setter TargetName="name" Property="Foreground" Value="{DynamicResource Muted}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Locked}" Value="True">
                                <Setter TargetName="sw" Property="ToolTip" Value="{Binding Path=[startup.needadmin], Source={x:Static core:Loc.I}}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</local:PageBase>
