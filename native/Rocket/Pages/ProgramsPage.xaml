<local:PageBase x:Class="Rocket.Pages.ProgramsPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:core="clr-namespace:Rocket.Core"
                xmlns:local="clr-namespace:Rocket.Pages">
    <local:PageBase.Resources>
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="14" Padding="12,5" Background="{DynamicResource Surface2}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:PageBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" VerticalAlignment="Top" Click="Refresh_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    <TextBlock Margin="8,0,0,0" Text="{Binding Path=[common.rescan], Source={x:Static core:Loc.I}}" />
                </StackPanel>
            </Button>
            <StackPanel Margin="0,0,24,0">
                <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Path=[prog.title], Source={x:Static core:Loc.I}}" />
                <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left"
                           Text="{Binding Path=[prog.sub], Source={x:Static core:Loc.I}}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,14">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="Total" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Bold" Text="…" />
                    <TextBlock x:Name="Summary" Style="{StaticResource Sub}" Text=" " />
                </StackPanel>
                <CheckBox x:Name="Quiet" Style="{StaticResource Switch}" IsChecked="True" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Content="{Binding Path=[prog.quiet], Source={x:Static core:Loc.I}}" />
            </Grid>
        </Border>

        <DockPanel Grid.Row="2" Margin="0,12,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <ComboBox x:Name="SortBox" Style="{StaticResource Combo}" Width="130" SelectionChanged="Sort_Changed" />
                <TextBox x:Name="Search" Style="{StaticResource Field}" Width="190" Margin="8,0,0,0" TextChanged="Search_Changed" Padding="10,6" />
            </StackPanel>
            <WrapPanel x:Name="Filters" />
        </DockPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6" Margin="0,6,0,20">
            <ListBox x:Name="List" Style="{StaticResource RowList}">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:Program}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="4,0,12,0">
                                <TextBlock x:Name="name" Text="{Binding Display}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Sub}" Style="{StaticResource Sub}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="store" Style="{StaticResource Badge}" Visibility="Collapsed" Background="{DynamicResource AccentSoft}" BorderBrush="Transparent">
                                    <TextBlock Style="{StaticResource BadgeText}" Foreground="{DynamicResource Accent}" Text="Store" />
                                </Border>
                                <Border x:Name="dep" Style="{StaticResource Badge}" Visibility="Collapsed" Background="{DynamicResource DangerSoft}" BorderBrush="Transparent">
                                    <TextBlock Style="{StaticResource BadgeText}" Foreground="{DynamicResource Warn}"
                                               Text="{Binding Path=[prog.dependency], Source={x:Static core:Loc.I}}" />
                                </Border>
                                <Border x:Name="broken" Style="{StaticResource Badge}" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Path=[prog.broken], Source={x:Static core:Loc.I}}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource Sub}" FontSize="11.5" VerticalAlignment="Center"
                                       TextAlignment="Right" FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                            <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Size}" />
                            <Button Grid.Column="4" Style="{StaticResource IconBtn}" Width="30" Height="28" Margin="8,0,0,0" Click="Reveal_Click"
                                    ToolTip="{Binding Path=[common.reveal], Source={x:Static core:Loc.I}}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                            <Button x:Name="go" Grid.Column="5" Style="{StaticResource DangerBtn}" Padding="12,6" Margin="6,0,0,0" Click="Uninstall_Click">
                                <TextBlock x:Name="goText" Text="{Binding Path=[prog.uninstall], Source={x:Static core:Loc.I}}" FontSize="12" />
                            </Button>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Store}" Value="True">
                                <Setter TargetName="store" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Dependency}" Value="True">
                                <Setter TargetName="dep" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasUninstaller}" Value="False">
                                <Setter TargetName="broken" Property="Visibility" Value="Visible" />
                                <Setter TargetName="goText" Property="Text" Value="{Binding Path=[prog.force], Source={x:Static core:Loc.I}}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="removing">
                                <Setter TargetName="go" Property="IsEnabled" Value="False" />
                                <Setter TargetName="goText" Property="Text" Value="{Binding Path=[prog.removing], Source={x:Static core:Loc.I}}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="removed">
                                <Setter TargetName="go" Property="IsEnabled" Value="False" />
                                <Setter TargetName="name" Property="TextDecorations" Value="Strikethrough" />
                                <Setter TargetName="goText" Property="Text" Value="{Binding Path=[prog.removed], Source={x:Static core:Loc.I}}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</local:PageBase>
