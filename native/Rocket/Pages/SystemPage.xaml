<local:PageBase x:Class="Rocket.Pages.SystemPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:core="clr-namespace:Rocket.Core"
                xmlns:local="clr-namespace:Rocket.Pages">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel Margin="0,0,0,24">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource Ghost}" Click="Copy_Click" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Margin="8,0,0,0" Text="{Binding Path=[pc.copy], Source={x:Static core:Loc.I}}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Ghost}" Click="Refresh_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Margin="8,0,0,0" Text="{Binding Path=[common.rescan], Source={x:Static core:Loc.I}}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Path=[pc.title], Source={x:Static core:Loc.I}}" />
                    <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left"
                               Text="{Binding Path=[pc.sub], Source={x:Static core:Loc.I}}" />
                </StackPanel>
            </DockPanel>

            <TextBlock x:Name="Loading" Style="{StaticResource Sub}" Margin="0,20,0,0" Text="{Binding Path=[pc.reading], Source={x:Static core:Loc.I}}" />
            <ProgressBar x:Name="Bar" Style="{StaticResource Meter}" Height="4" IsIndeterminate="True" Margin="0,8,0,0" />

            <!-- advice -->
            <TextBlock x:Name="Banner" Style="{StaticResource H2}" Margin="0,18,0,8" FontSize="17" Visibility="Collapsed" />
            <ItemsControl x:Name="AdviceList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:Advice}">
                        <Border x:Name="b" CornerRadius="14" Padding="16,12" Margin="0,0,0,8" Background="{DynamicResource Surface2}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="plate" Width="32" Height="32" CornerRadius="10" Background="{DynamicResource AccentSoft}" VerticalAlignment="Top">
                                    <TextBlock x:Name="g" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="13" Foreground="{DynamicResource Accent}" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Why}" Style="{StaticResource Sub}" FontSize="12" Margin="0,2,0,0" />
                                    <TextBlock x:Name="sugg" Text="{Binding Suggestion}" Style="{StaticResource Sub}" FontSize="12" Margin="0,4,0,0"
                                               Foreground="{DynamicResource Accent}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsGood}" Value="True">
                                <Setter TargetName="plate" Property="Background" Value="{DynamicResource SuccessSoft}" />
                                <Setter TargetName="g" Property="Foreground" Value="{DynamicResource Success}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsUpgrade}" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentLine}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Suggestion}" Value="">
                                <Setter TargetName="sugg" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- specs -->
            <ItemsControl x:Name="Cards" Margin="0,10,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type core:SpecCard}">
                        <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="18,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource Accent}" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" Margin="10,0,0,0" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Lines}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type core:Spec}">
                                            <Grid Margin="0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Style="{StaticResource Sub}" FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" TextWrapping="Wrap" Margin="8,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</local:PageBase>
