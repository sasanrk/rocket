<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- A deep, slightly violet night: surfaces step up in small, even stairs. -->
    <SolidColorBrush x:Key="Bg"        Color="#0B0C12" />
    <SolidColorBrush x:Key="Surface"   Color="#11131B" />
    <SolidColorBrush x:Key="Surface2"  Color="#1A1D2A" />
    <SolidColorBrush x:Key="Hover"     Color="#232838" />
    <SolidColorBrush x:Key="Border"    Color="#252A3A" />
    <SolidColorBrush x:Key="BorderHi"  Color="#353B52" />
    <SolidColorBrush x:Key="Text"      Color="#F2F3F8" />
    <SolidColorBrush x:Key="Muted"     Color="#A3AAC0" />
    <SolidColorBrush x:Key="Faint"     Color="#6B7390" />

    <SolidColorBrush x:Key="SwitchTrack" Color="#232838" />
    <SolidColorBrush x:Key="SwitchThumb" Color="#A3AAC0" />

    <SolidColorBrush x:Key="Accent"     Color="#8B7DFF" />
    <SolidColorBrush x:Key="AccentText" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSoft" Color="#268B7DFF" />
    <SolidColorBrush x:Key="AccentLine" Color="#558B7DFF" />
    <SolidColorBrush x:Key="Danger"     Color="#FF5C6C" />
    <SolidColorBrush x:Key="DangerSoft" Color="#22FF5C6C" />
    <SolidColorBrush x:Key="Success"    Color="#2EE6A6" />
    <SolidColorBrush x:Key="SuccessSoft" Color="#1F2EE6A6" />
    <SolidColorBrush x:Key="Warn"       Color="#FFB547" />

    <Color x:Key="AccentColor">#8B7DFF</Color>
    <Color x:Key="GlowColor">#7A5CFF</Color>
    <Color x:Key="RecordGlowColor">#FF4D6D</Color>
    <Color x:Key="ShadowColor">#000000</Color>

    <LinearGradientBrush x:Key="AccentGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5B7CFF" Offset="0" />
        <GradientStop Color="#8A5CFF" Offset="0.55" />
        <GradientStop Color="#B44CFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="RecordGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF4D6D" Offset="0" />
        <GradientStop Color="#FF8A3D" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ShotGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#12C2E9" Offset="0" />
        <GradientStop Color="#2EE6A6" Offset="1" />
    </LinearGradientBrush>

    <!-- cards: lit from above, a hair lighter at the top edge -->
    <LinearGradientBrush x:Key="CardBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#171A26" Offset="0" />
        <GradientStop Color="#131620" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#363C54" Offset="0" />
        <GradientStop Color="#222737" Offset="0.35" />
        <GradientStop Color="#1E2232" Offset="1" />
    </LinearGradientBrush>

    <!-- the hero: the brand gradient, deepened so white text sits on it comfortably -->
    <LinearGradientBrush x:Key="HeroGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4B5BF0" Offset="0" />
        <GradientStop Color="#7348F0" Offset="0.55" />
        <GradientStop Color="#A23BEA" Offset="1" />
    </LinearGradientBrush>

    <!-- a soft aurora behind the content: identity without noise -->
    <RadialGradientBrush x:Key="Aurora" Center="0.88,0" GradientOrigin="0.88,0" RadiusX="0.75" RadiusY="0.9">
        <GradientStop Color="#2A6A4BFF" Offset="0" />
        <GradientStop Color="#106A4BFF" Offset="0.45" />
        <GradientStop Color="#006A4BFF" Offset="1" />
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="Aurora2" Center="0.05,1" GradientOrigin="0.05,1" RadiusX="0.6" RadiusY="0.7">
        <GradientStop Color="#14B44CFF" Offset="0" />
        <GradientStop Color="#00B44CFF" Offset="1" />
    </RadialGradientBrush>

    <!-- selected navigation row -->
    <LinearGradientBrush x:Key="NavSel" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2E7C6CFF" Offset="0" />
        <GradientStop Color="#0C7C6CFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="Scrim" Color="#D90B0C12" />

</ResourceDictionary>
