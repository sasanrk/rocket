<Window x:Class="Rocket.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Rocket.Core"
        xmlns:local="clr-namespace:Rocket"
        xmlns:pages="clr-namespace:Rocket.Pages"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Rocket" Height="760" Width="1180" MinHeight="600" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource UiFont}"
        WindowStyle="None">

    <Window.TaskbarItemInfo>
        <TaskbarItemInfo x:Name="Taskbar" />
    </Window.TaskbarItemInfo>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVis" />

        <!-- ── a cleanable thing on the Quick clean page ── -->
        <DataTemplate x:Key="CleanRow" DataType="{x:Type core:Item}">
            <Border x:Name="b" CornerRadius="10" Padding="12,8" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="tick" Style="{StaticResource Tick}" IsChecked="{Binding IsChecked}" />
                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Sub}" FontSize="11.5" LineHeight="17"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                        <TextBlock Text="{Binding PathText}" Style="{StaticResource PathText}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="review" Style="{StaticResource Badge}" Visibility="Collapsed"
                                Background="{DynamicResource DangerSoft}" BorderBrush="Transparent">
                            <TextBlock Style="{StaticResource BadgeText}" Foreground="{DynamicResource Warn}"
                                       Text="{Binding Path=[badge.review], Source={x:Static core:Loc.I}}" />
                        </Border>
                        <Border x:Name="admin" Style="{StaticResource Badge}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="10" Foreground="{DynamicResource Muted}" Margin="0,0,4,0" />
                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding Path=[badge.admin], Source={x:Static core:Loc.I}}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="doneMark" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12"
                                   Foreground="{DynamicResource Success}" Margin="0,0,6,0" Visibility="Collapsed" />
                        <TextBlock x:Name="size" Style="{StaticResource Size}" Text="{Binding SizeText}" />
                    </StackPanel>
                    <Button Grid.Column="4" Style="{StaticResource IconBtn}" Width="30" Height="28" Margin="8,0,0,0"
                            Click="Reveal_Click" ToolTip="{Binding Path=[common.reveal], Source={x:Static core:Loc.I}}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsReview}" Value="True">
                    <Setter TargetName="review" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Locked}" Value="True">
                    <Setter TargetName="admin" Property="Visibility" Value="Visible" />
                    <Setter TargetName="tick" Property="IsEnabled" Value="False" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Measured}" Value="False">
                    <Setter TargetName="size" Property="Foreground" Value="{DynamicResource Faint}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="cleaning">
                    <Setter TargetName="size" Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="done">
                    <Setter TargetName="doneMark" Property="Visibility" Value="Visible" />
                    <Setter TargetName="size" Property="Foreground" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="partial">
                    <Setter TargetName="doneMark" Property="Visibility" Value="Visible" />
                    <Setter TargetName="doneMark" Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── a card of rows with a select-all box ── -->
        <DataTemplate x:Key="GroupCard" DataType="{x:Type core:Group}">
            <Border Style="{StaticResource Card}" Padding="6" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="12,10,12,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Style="{StaticResource Tick}" IsThreeState="True" IsChecked="{Binding AllChecked, Mode=TwoWay}"
                                  Click="GroupTick_Click" />
                        <Border Grid.Column="1" Style="{StaticResource Plate}" Width="36" Height="36" CornerRadius="11" Margin="12,0,0,0">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource Accent}" />
                        </Border>
                        <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource H2}" />
                            <TextBlock Text="{Binding Hint}" Style="{StaticResource Sub}" FontSize="11.5" TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding TotalText}" Style="{StaticResource Size}" FontSize="16"
                                   Margin="0,0,6,0" />
                        <ToggleButton Grid.Column="4" IsChecked="{Binding Expanded}" Cursor="Hand" Width="32" Height="30"
                                      Margin="6,0,0,0" Background="Transparent" BorderThickness="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bg" CornerRadius="9" Background="Transparent">
                                        <TextBlock x:Name="g" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="11"
                                                   Foreground="{DynamicResource Muted}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="g" Property="Text" Value="&#xE70E;" />
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="{DynamicResource Hover}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource CleanRow}"
                                  Visibility="{Binding Expanded, Converter={StaticResource BoolVis}}" Margin="0,0,0,4" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ── a project artifact ── -->
        <DataTemplate x:Key="ProjectRow" DataType="{x:Type core:Item}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource Tick}" IsChecked="{Binding IsChecked}" />
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding PathText}" Style="{StaticResource PathText}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="review" Style="{StaticResource Badge}" Visibility="Collapsed"
                            Background="{DynamicResource DangerSoft}" BorderBrush="Transparent">
                        <TextBlock Style="{StaticResource BadgeText}" Foreground="{DynamicResource Warn}"
                                   Text="{Binding Path=[badge.review], Source={x:Static core:Loc.I}}" />
                    </Border>
                    <Border Style="{StaticResource Badge}" Background="{DynamicResource AccentSoft}" BorderBrush="Transparent">
                        <TextBlock Style="{StaticResource BadgeText}" Foreground="{DynamicResource Accent}" Text="{Binding Badge}" />
                    </Border>
                </StackPanel>
                <TextBlock Grid.Column="3" Text="{Binding IdleText}" Style="{StaticResource Sub}" FontSize="11.5"
                           VerticalAlignment="Center" TextAlignment="Right" TextWrapping="NoWrap" />
                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="doneMark" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12"
                               Foreground="{DynamicResource Success}" Margin="0,0,6,0" Visibility="Collapsed" />
                    <TextBlock x:Name="size" Style="{StaticResource Size}" Text="{Binding SizeText}" />
                </StackPanel>
                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Style="{StaticResource IconBtn}" Width="30" Height="28"
                            Click="Reveal_Click" ToolTip="{Binding Path=[common.reveal], Source={x:Static core:Loc.I}}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                    <Button x:Name="moveProject" Style="{StaticResource IconBtn}" Width="30" Height="28" Margin="2,0,0,0" Visibility="Collapsed"
                            Click="ProjectMove_Click" ToolTip="{Binding Path=[move.project], Source={x:Static core:Loc.I}}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8DE;" FontSize="12"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CanMove}" Value="True">
                    <Setter TargetName="moveProject" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsReview}" Value="True">
                    <Setter TargetName="review" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Measured}" Value="False">
                    <Setter TargetName="size" Property="Foreground" Value="{DynamicResource Faint}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="cleaning">
                    <Setter TargetName="size" Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="done">
                    <Setter TargetName="doneMark" Property="Visibility" Value="Visible" />
                    <Setter TargetName="size" Property="Foreground" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="partial">
                    <Setter TargetName="doneMark" Property="Visibility" Value="Visible" />
                    <Setter TargetName="doneMark" Property="Foreground" Value="{DynamicResource Warn}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── a folder or file on the space map ── -->
        <DataTemplate x:Key="MapRowTemplate" DataType="{x:Type core:MapRow}">
            <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="glyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="15"
                           Foreground="{DynamicResource Accent}" />
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Display}" FontWeight="Medium" FontSize="13" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding FilesText}" Style="{StaticResource Sub}" FontSize="11" TextWrapping="NoWrap" />
                </StackPanel>
                <Border Grid.Column="2" Height="6" CornerRadius="3" Background="{DynamicResource Hover}" VerticalAlignment="Center">
                    <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="3" Background="{DynamicResource AccentGrad}" />
                </Border>
                <TextBlock Grid.Column="3" Text="{Binding ShareText}" Style="{StaticResource Sub}" FontSize="11"
                           VerticalAlignment="Center" TextAlignment="Right" TextWrapping="NoWrap" />
                <TextBlock Grid.Column="4" Text="{Binding SizeText}" Style="{StaticResource Size}" />
                <Button Grid.Column="5" Style="{StaticResource IconBtn}" Width="30" Height="28" Margin="8,0,0,0"
                        Click="MapReveal_Click" ToolTip="{Binding Path=[common.reveal], Source={x:Static core:Loc.I}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE838;" FontSize="12"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button x:Name="move" Grid.Column="6" Style="{StaticResource IconBtn}" Width="30" Height="28" Margin="2,0,0,0"
                        Click="MapMove_Click" ToolTip="{Binding Path=[move.tip], Source={x:Static core:Loc.I}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8DE;" FontSize="12"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
                <Button Grid.Column="7" Style="{StaticResource CloseBtn}" Width="30" Height="28" Margin="2,0,0,0"
                        Click="MapDelete_Click" ToolTip="{Binding Path=[map.delete], Source={x:Static core:Loc.I}}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDir}" Value="False">
                    <Setter TargetName="glyph" Property="Foreground" Value="{DynamicResource Muted}" />
                    <Setter TargetName="move" Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── a drive in the rail: one line and a bar ── -->
        <DataTemplate x:Key="DriveCard" DataType="{x:Type local:DriveVm}">
            <Grid Margin="18,0,18,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding Letter}" FontWeight="Bold" FontSize="12.5" FlowDirection="LeftToRight" HorizontalAlignment="Left" />
                <TextBlock x:Name="free" Text="{Binding FreeShort}" HorizontalAlignment="Right" FontSize="11.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Muted}" />
                <Grid Grid.Row="1" Height="5" Margin="0,5,0,0">
                    <Border CornerRadius="2.5" Background="{DynamicResource Hover}" />
                    <Border x:Name="fill" CornerRadius="2.5" HorizontalAlignment="Left" Background="{DynamicResource AccentGrad}"
                            Width="{Binding BarWidth}" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Critical}" Value="True">
                    <Setter TargetName="fill" Property="Background" Value="{DynamicResource RecordGrad}" />
                    <Setter TargetName="free" Property="Foreground" Value="{DynamicResource Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══ title bar ══════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Background="{DynamicResource Surface}" MouseLeftButtonDown="TitleBar_Drag">
            <Border VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Border}" />
            <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
                <Grid Width="30" Height="30">
                    <Border CornerRadius="9" Background="{DynamicResource AccentGrad}" Margin="3,5,3,1" Opacity="0.8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.9"
                                              Color="{DynamicResource GlowColor}" />
                        </Border.Effect>
                    </Border>
                    <Border CornerRadius="9" Background="{DynamicResource AccentGrad}">
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <TextBlock Text="Rocket" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="Bold"
                           Margin="11,0,0,1" VerticalAlignment="Center" />
                <Border Width="1" Height="14" Background="{DynamicResource BorderHi}" Margin="12,1,0,0" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Sub}" Margin="12,1,0,0" VerticalAlignment="Center"
                           Text="{Binding Path=[app.tagline], Source={x:Static core:Loc.I}}" />
                <Border x:Name="AdminChip" Style="{StaticResource AccentChip}" Margin="12,0,0,0" Visibility="Collapsed" Padding="8,2">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7EF;" FontSize="11" Foreground="{DynamicResource Accent}" />
                        <TextBlock Text="Admin" FontSize="11" Margin="5,0,0,0" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,0" VerticalAlignment="Center">
                <!-- a clean-up running in the background: click to see it -->
                <Button x:Name="JobPill" Cursor="Hand" Click="JobPill_Click" Margin="0,0,10,0" Visibility="Collapsed"
                        ToolTip="{Binding Path=[job.open], Source={x:Static core:Loc.I}}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" CornerRadius="15" Padding="12,5" Background="{DynamicResource AccentSoft}"
                                    BorderBrush="{DynamicResource AccentLine}" BorderThickness="1">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="JobGlyph" Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="12"
                                   Foreground="{DynamicResource Accent}" RenderTransformOrigin="0.5,0.5" />
                        <TextBlock x:Name="JobText" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ProgressBar x:Name="JobBar" Style="{StaticResource Meter}" Width="70" Height="4" Maximum="1"
                                     Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconBtn}" Width="46" Click="Lang_Click" ToolTip="Language / زبان">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="13" />
                        <TextBlock x:Name="LangLabel" Text="EN" FontSize="10.5" Margin="5,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource Muted}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource IconBtn}" Click="Theme_Click">
                    <TextBlock x:Name="ThemeGlyph" Style="{StaticResource Icon}" Text="&#xE706;" />
                </Button>
                <Border Width="1" Height="18" Background="{DynamicResource Border}" Margin="6,0" />
                <Button Style="{StaticResource IconBtn}" Click="Minimize_Click">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE921;" FontSize="11" />
                </Button>
                <Button Style="{StaticResource IconBtn}" Click="Maximize_Click">
                    <TextBlock x:Name="MaxGlyph" Style="{StaticResource Icon}" Text="&#xE922;" FontSize="11" />
                </Button>
                <Button Style="{StaticResource CloseBtn}" Click="Close_Click">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8BB;" FontSize="11" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ══ body ═══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="268" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- rail -->
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4,0,16">
                        <TextBlock Style="{StaticResource GroupLabel}" Text="{Binding Path=[nav.drives], Source={x:Static core:Loc.I}}" />
                        <ItemsControl x:Name="DriveList" ItemTemplate="{StaticResource DriveCard}" />
                        <RadioButton x:Name="NavOverview" Style="{StaticResource NavItem}" Tag="&#xE80F;" GroupName="nav" IsChecked="True" Checked="Nav_Checked">
                            <StackPanel>
                                <TextBlock Style="{StaticResource NavTitle}" Text="{Binding Path=[nav.overview], Source={x:Static core:Loc.I}}" />
                                <TextBlock Style="{StaticResource NavHint}" Text="{Binding Path=[nav.overview.hint], Source={x:Static core:Loc.I}}" />
                            </StackPanel>
                        </RadioButton>
                        <TextBlock Style="{StaticResource GroupLabel}" Text="{Binding Path=[nav.g.space], Source={x:Static core:Loc.I}}" />
                        <RadioButton x:Name="NavClean" Style="{StaticResource NavItem}" Tag="&#xE945;" GroupName="nav" Checked="Nav_Checked">
                            <StackPanel>
                                <TextBlock Style="{StaticResource NavTitle}" Text="{Binding Path=[nav.clean], Source={x:Static core:Loc.I}}" />
                                <TextBlock Style="{StaticResource NavHint}" Text="{Binding Path=[nav.clean.hint], Source={x:Static core:Loc.I}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavProjects" Style="{StaticResource NavItem}" Tag="&#xE943;" GroupName="nav" Checked="Nav_Checked">
                            <StackPanel>
                                <TextBlock Style="{StaticResource NavTitle}" Text="{Binding Path=[nav.projects], Source={x:Static core:Loc.I}}" />
                                <TextBlock x:Name="NavProjectsHint" Style="{StaticResource NavHint}" Text="{Binding Path=[nav.projects.hint], Source={x:Static core:Loc.I}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavModels" Style="{StaticResource NavItem}" Tag="&#xE99A;" GroupName="nav" Checked="Nav_Checked">
                            <StackPanel>
                                <TextBlock Style="{StaticResource NavTitle}" Text="{Binding Path=[nav.models], Source={x:Static core:Loc.I}}" />
                                <TextBlock Style="{StaticResource NavHint}" Text="{Binding Path=[nav.models.hint], Source={x:Static core:Loc.I}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavPrograms" Style="{StaticResource NavItem}" Tag="&#xE71D;" GroupName="nav" Checked="Nav_Checked">
                            <StackPanel>
                                <TextBlock Style="{StaticResource NavTitle}" Text="{Binding Path=[nav.programs], Source={x:Static core:Loc.I}}" />
                                <TextBlock Style="{StaticResource NavHint}" Text="{Binding Path=[nav.programs.hint], Source={x:Static core:Loc.I}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavMap" Style="{StaticResource NavItem}" Tag="&#xEB05;" GroupName="nav" Checked="Nav_Checked">
                            <StackPanel>
                                <TextBlock Style="{StaticResource NavTitle}" Text="{Binding Path=[nav.map], Source={x:Static core:Loc.I}}" />
                                <TextBlock Style="{StaticResource NavHint}" Text="{Binding Path=[nav.map.hint], Source={x:Static core:Loc.I}}" />
                            </StackPanel>
                        </RadioButton>
                        <TextBlock Style="{StaticResource GroupLabel}" Text="{Binding Path=[nav.g.speed], Source={x:Static core:Loc.I}}" />
                        <RadioButton x:Name="NavStartup" Style="{StaticResource NavItem}" Tag="&#xE7E8;" GroupName="nav" Checked="Nav_Checked">
                            <StackPanel>
                                <TextBlock Style="{StaticResource NavTitle}" Text="{Binding Path=[nav.startup], Source={x:Static core:Loc.I}}" />
                                <TextBlock Style="{StaticResource NavHint}" Text="{Binding Path=[nav.startup.hint], Source={x:Static core:Loc.I}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavProcesses" Style="{StaticResource NavItem}" Tag="&#xE9D9;" GroupName="nav" Checked="Nav_Checked">
                            <StackPanel>
                                <TextBlock Style="{StaticResource NavTitle}" Text="{Binding Path=[nav.processes], Source={x:Static core:Loc.I}}" />
                                <TextBlock Style="{StaticResource NavHint}" Text="{Binding Path=[nav.processes.hint], Source={x:Static core:Loc.I}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavTune" Style="{StaticResource NavItem}" Tag="&#xEC4A;" GroupName="nav" Checked="Nav_Checked">
                            <StackPanel>
                                <TextBlock Style="{StaticResource NavTitle}" Text="{Binding Path=[nav.tune], Source={x:Static core:Loc.I}}" />
                                <TextBlock Style="{StaticResource NavHint}" Text="{Binding Path=[nav.tune.hint], Source={x:Static core:Loc.I}}" />
                            </StackPanel>
                        </RadioButton>
                        <TextBlock Style="{StaticResource GroupLabel}" Text="{Binding Path=[nav.g.system], Source={x:Static core:Loc.I}}" />
                        <RadioButton x:Name="NavSystem" Style="{StaticResource NavItem}" Tag="&#xE7F8;" GroupName="nav" Checked="Nav_Checked">
                            <StackPanel>
                                <TextBlock Style="{StaticResource NavTitle}" Text="{Binding Path=[nav.system], Source={x:Static core:Loc.I}}" />
                                <TextBlock Style="{StaticResource NavHint}" Text="{Binding Path=[nav.system.hint], Source={x:Static core:Loc.I}}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavHistory" Style="{StaticResource NavItem}" Tag="&#xE81C;" GroupName="nav" Checked="Nav_Checked">
                            <StackPanel>
                                <TextBlock Style="{StaticResource NavTitle}" Text="{Binding Path=[nav.history], Source={x:Static core:Loc.I}}" />
                                <TextBlock Style="{StaticResource NavHint}" Text="{Binding Path=[nav.history.hint], Source={x:Static core:Loc.I}}" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- pages -->
            <Grid Grid.Column="1" ClipToBounds="True">
                <Border Background="{DynamicResource Aurora}" IsHitTestVisible="False" />

                <pages:OverviewPage x:Name="PageOverview" />
                <pages:ProgramsPage x:Name="PagePrograms" Visibility="Collapsed" />
                <pages:StartupPage x:Name="PageStartup" Visibility="Collapsed" />
                <pages:ProcessesPage x:Name="PageProcesses" Visibility="Collapsed" />
                <pages:TunePage x:Name="PageTune" Visibility="Collapsed" />
                <pages:SystemPage x:Name="PageSystem" Visibility="Collapsed" />

                <!-- ── Quick clean ── -->
                <Grid x:Name="PageClean" Margin="28,20,28,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" VerticalAlignment="Top" Click="CleanRescan_Click"
                                x:Name="BtnCleanRescan">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Margin="8,0,0,0" Text="{Binding Path=[common.rescan], Source={x:Static core:Loc.I}}" />
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Path=[clean.title], Source={x:Static core:Loc.I}}" />
                            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left"
                                       Text="{Binding Path=[clean.sub], Source={x:Static core:Loc.I}}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Sub}" Text="{Binding Path=[common.canfree], Source={x:Static core:Loc.I}}" />
                                <TextBlock x:Name="CleanSelected" Text="…" FontFamily="{StaticResource DisplayFont}" FontSize="38"
                                           FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,2,0,0" />
                                <TextBlock x:Name="CleanFound" Style="{StaticResource Sub}" Text=" " />
                            </StackPanel>
                            <Button x:Name="BtnClean" Grid.Column="1" Style="{StaticResource Primary}" Padding="28,14" FontSize="14"
                                    VerticalAlignment="Center" Click="Clean_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Foreground="White" />
                                    <TextBlock x:Name="BtnCleanText" Margin="10,0,0,0" Text="…" />
                                </StackPanel>
                            </Button>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,14,0,0">
                                <ProgressBar x:Name="CleanBar" Style="{StaticResource Meter}" Height="5" Maximum="1" />
                                <TextBlock x:Name="CleanStatus" Style="{StaticResource Sub}" FontSize="11.5" Margin="0,6,0,0" Text=" " />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border x:Name="AdminBanner" Grid.Row="2" Margin="0,12,0,0" CornerRadius="12" Padding="16,10"
                            Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentLine}" BorderThickness="1"
                            Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Click="Elevate_Click" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7EF;" FontSize="12"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Margin="8,0,0,0" Text="{Binding Path=[admin.btn], Source={x:Static core:Loc.I}}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" FontSize="13" Foreground="{DynamicResource Accent}" />
                            <TextBlock x:Name="AdminText" Margin="10,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </Border>

                    <ScrollViewer Grid.Row="3" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                        <ItemsControl x:Name="CleanGroups" ItemTemplate="{StaticResource GroupCard}" Margin="0,0,0,20" />
                    </ScrollViewer>
                </Grid>

                <!-- ── Projects ── -->
                <Grid x:Name="PageProjects" Margin="28,20,28,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" VerticalAlignment="Top" Click="ProjectsScan_Click"
                                x:Name="BtnProjectsScan">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Margin="8,0,0,0" Text="{Binding Path=[common.rescan], Source={x:Static core:Loc.I}}" />
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Path=[projects.title], Source={x:Static core:Loc.I}}" />
                            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left"
                                       Text="{Binding Path=[projects.sub], Source={x:Static core:Loc.I}}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Sub}" Text="{Binding Path=[common.canfree], Source={x:Static core:Loc.I}}" />
                                <TextBlock x:Name="ProjSelected" Text="…" FontFamily="{StaticResource DisplayFont}" FontSize="34"
                                           FontWeight="Bold" Margin="0,2,0,0" />
                                <TextBlock x:Name="ProjFound" Style="{StaticResource Sub}" Text=" " />
                            </StackPanel>
                            <Button x:Name="BtnProjClean" Grid.Column="1" Style="{StaticResource Primary}" Padding="28,14" FontSize="14"
                                    VerticalAlignment="Center" Click="ProjClean_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Foreground="White" />
                                    <TextBlock x:Name="BtnProjCleanText" Margin="10,0,0,0" Text="…" />
                                </StackPanel>
                            </Button>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
                                <ProgressBar x:Name="ProjBar" Style="{StaticResource Meter}" Height="5" Maximum="1" />
                                <TextBlock x:Name="ProjStatus" Style="{StaticResource Sub}" FontSize="11.5" Margin="0,6,0,0" Text=" " />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <WrapPanel Grid.Row="2" Margin="0,12,0,4" Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Sub}" VerticalAlignment="Center"
                                   Text="{Binding Path=[projects.idle], Source={x:Static core:Loc.I}}" />
                        <ComboBox x:Name="IdleCombo" Style="{StaticResource Combo}" Width="110" Margin="10,0,0,0"
                                  SelectionChanged="Idle_Changed" />
                        <Button Style="{StaticResource Ghost}" Margin="10,0,0,0" Padding="12,7" Click="ProjCachesOnly_Click"
                                Content="{Binding Path=[projects.caches], Source={x:Static core:Loc.I}}" />
                        <Button Style="{StaticResource Ghost}" Margin="8,0,0,0" Padding="12,7" Click="ProjAll_Click"
                                Content="{Binding Path=[common.selectall], Source={x:Static core:Loc.I}}" />
                        <Button Style="{StaticResource Ghost}" Margin="8,0,0,0" Padding="12,7" Click="ProjNone_Click"
                                Content="{Binding Path=[common.selectnone], Source={x:Static core:Loc.I}}" />
                        <Button Style="{StaticResource Ghost}" Margin="8,0,0,0" Padding="12,7" Click="ProjAddRoot_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE710;" FontSize="11"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Margin="7,0,0,0" Text="{Binding Path=[projects.add], Source={x:Static core:Loc.I}}" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="ProjRoots" Style="{StaticResource Sub}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="420" TextWrapping="NoWrap" />
                    </WrapPanel>

                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6" Margin="0,8,0,20">
                        <ListBox x:Name="ProjectList" Style="{StaticResource RowList}" ItemTemplate="{StaticResource ProjectRow}" />
                    </Border>
                </Grid>

                <!-- ── AI models ── -->
                <Grid x:Name="PageModels" Margin="28,20,28,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" VerticalAlignment="Top" Click="ModelsScan_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE72C;" FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Margin="8,0,0,0" Text="{Binding Path=[common.rescan], Source={x:Static core:Loc.I}}" />
                            </StackPanel>
                        </Button>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Path=[models.title], Source={x:Static core:Loc.I}}" />
                            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" MaxWidth="760" HorizontalAlignment="Left"
                                       Text="{Binding Path=[models.sub], Source={x:Static core:Loc.I}}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="ModelsSelected" Text="…" FontFamily="{StaticResource DisplayFont}" FontSize="30" FontWeight="Bold" />
                                <TextBlock x:Name="ModelsFound" Style="{StaticResource Sub}" Text=" " />
                            </StackPanel>
                            <Button x:Name="BtnModelsClean" Grid.Column="1" Style="{StaticResource Primary}" Padding="28,14" FontSize="14"
                                    VerticalAlignment="Center" Click="ModelsClean_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" FontSize="14" Foreground="White" />
                                    <TextBlock x:Name="BtnModelsCleanText" Margin="10,0,0,0" Text="…" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6" Margin="0,12,0,20">
                        <Grid>
                            <ListBox x:Name="ModelList" Style="{StaticResource RowList}" ItemTemplate="{StaticResource ProjectRow}" />
                            <TextBlock x:Name="ModelsEmpty" Style="{StaticResource Sub}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- ── Space map ── -->
                <Grid x:Name="PageMap" Margin="28,20,28,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <ItemsControl x:Name="MapDrives" DockPanel.Dock="Right" VerticalAlignment="Top">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:DriveVm}">
                                    <Button Style="{StaticResource Ghost}" Margin="8,0,0,0" Click="MapDrive_Click" Padding="12,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xEDA2;" FontSize="12"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                            <TextBlock Margin="8,0,0,0" Text="{Binding Letter}" FontWeight="SemiBold" FlowDirection="LeftToRight" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Path=[map.title], Source={x:Static core:Loc.I}}" />
                            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="{Binding Path=[map.sub], Source={x:Static core:Loc.I}}" />
                        </StackPanel>
                    </DockPanel>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14,12">
                        <StackPanel>
                            <DockPanel>
                                <Button x:Name="BtnMapUp" Style="{StaticResource Ghost}" Padding="10,6" Click="MapUp_Click" IsEnabled="False">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="MapUpGlyph" Style="{StaticResource Icon}" Text="&#xE72B;" FontSize="11"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Margin="7,0,0,0" Text="{Binding Path=[map.up], Source={x:Static core:Loc.I}}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="MapSize" DockPanel.Dock="Right" Style="{StaticResource Size}" FontSize="16" />
                                <TextBlock x:Name="MapPath" Margin="14,0" VerticalAlignment="Center" FontWeight="SemiBold"
                                           FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <ProgressBar x:Name="MapBar" Style="{StaticResource Meter}" Height="4" Maximum="1" Margin="0,10,0,0" />
                            <TextBlock x:Name="MapStatus" Style="{StaticResource Sub}" FontSize="11.5" Margin="0,6,0,0" Text=" " />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="6" Margin="0,12,0,20">
                        <ListBox x:Name="MapList" Style="{StaticResource RowList}" ItemTemplate="{StaticResource MapRowTemplate}"
                                 MouseDoubleClick="MapList_DoubleClick" />
                    </Border>
                </Grid>

                <!-- ── History ── -->
                <Grid x:Name="PageHistory" Margin="28,20,28,0" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Path=[history.title], Source={x:Static core:Loc.I}}" />
                        <TextBlock x:Name="HistoryTotal" Style="{StaticResource Sub}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0,16,0,20">
                        <Grid>
                            <ListBox x:Name="HistoryList" Style="{StaticResource RowList}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:Run}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="100" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding WhenText}" FlowDirection="LeftToRight" FontWeight="Medium" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource Sub}" TextWrapping="NoWrap"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding FreedText}" Style="{StaticResource Size}" Foreground="{DynamicResource Success}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="HistoryEmpty" Style="{StaticResource Sub}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Text="{Binding Path=[history.none], Source={x:Static core:Loc.I}}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ══ toast: one line about what just happened ════════════════════ -->
        <Border x:Name="ToastBox" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26"
                CornerRadius="12" Padding="16,10" Background="{DynamicResource Surface}" BorderThickness="1"
                BorderBrush="{DynamicResource BorderHi}" Visibility="Collapsed" IsHitTestVisible="False" MaxWidth="620">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.35" Color="{DynamicResource ShadowColor}" />
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ToastGlyph" Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="13" />
                <TextBlock x:Name="ToastText" Margin="10,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="560" />
            </StackPanel>
        </Border>

        <!-- ══ sheet: confirm, progress, result ══════════════════════════ -->
        <Grid x:Name="Sheet" Grid.RowSpan="2" Visibility="Collapsed">
            <Border Background="{DynamicResource Scrim}" />
            <Border Style="{StaticResource Card}" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,22">
                <StackPanel>
                    <TextBlock x:Name="SheetTitle" Style="{StaticResource H1}" FontSize="21" />
                    <TextBlock x:Name="SheetBody" Style="{StaticResource Sub}" FontSize="13" Margin="0,8,0,0" />
                    <TextBlock x:Name="SheetNote" Style="{StaticResource Sub}" FontSize="12.5" Margin="0,6,0,0" Foreground="{DynamicResource Warn}" />
                    <StackPanel x:Name="SheetProgress" Margin="0,14,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SheetFreed" FontFamily="{StaticResource DisplayFont}" FontSize="40" FontWeight="Bold"
                                       Foreground="{DynamicResource Success}" />
                            <TextBlock Style="{StaticResource Sub}" VerticalAlignment="Bottom" Margin="10,0,0,10"
                                       Text="{Binding Path=[progress.freed], Source={x:Static core:Loc.I}}" />
                        </StackPanel>
                        <ProgressBar x:Name="SheetBar" Style="{StaticResource Meter}" Maximum="1" Margin="0,10,0,0" />
                        <TextBlock x:Name="SheetCurrent" Style="{StaticResource Sub}" FontSize="11.5" Margin="0,8,0,0"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button x:Name="SheetCancel" Style="{StaticResource Ghost}" Click="SheetCancel_Click" Padding="18,9" />
                        <Button x:Name="SheetHide" Style="{StaticResource Primary}" Click="SheetHide_Click" Padding="18,9" Margin="10,0,0,0"
                                Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A7;" FontSize="12" Foreground="White" />
                                <TextBlock Margin="8,0,0,0" Text="{Binding Path=[job.background], Source={x:Static core:Loc.I}}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SheetGo" Style="{StaticResource DangerBtn}" Click="SheetGo_Click" Padding="20,9" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
