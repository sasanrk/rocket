{
  "name": "reclaim",
  "productName": "Rocket",
  "version": "1.2.0",
  "description": "PC tune-up kit: free disk space, empty app junk, boost the CPU",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/start.cjs",
    "desktop": "npm run start",
    "build": "vite build",
    "preview": "vite preview",
    "dist": "vite build && electron-builder",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .js,.cjs,.jsx,.ts,.tsx",
    "check": "npm run typecheck && npm run lint",
    "selftest": "node scripts/selftest.cjs",
    "doctor": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/doctor.ps1",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop.ps1",
    "menu": "powershell -NoProfile -ExecutionPolicy Bypass -File run.ps1"
  },
  "devDependencies": {
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^5.54.0",
    "@typescript-eslint/parser": "^5.54.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "date-fns": "^4.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "framer-motion": "^11.18.2",
    "lucide-react": "0.522.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "3.4.17",
    "typescript": "^5.5.4",
    "vite": "^5.2.0",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "dev.rocket.app",
    "productName": "Rocket",
    "directories": {
      "output": "release"
    },
    "compression": "maximum",
    "electronLanguages": ["en-US", "fa"],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/*.png",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Rocket-Setup-${version}.${ext}",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "electron/agent.ps1",
      "build/*.png"
    ]
  }
}
